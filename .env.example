ATS_DATA_DIR=data
ATS_MAX_FILE_MB=10
# Optional: keep unset to continue using local SQLite.
# ATS_DATABASE_URL_OVERRIDE=postgresql+psycopg://ats:PASSWORD@localhost:5433/job_hire_ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_THREAD=2
OLLAMA_TIMEOUT=120
OLLAMA_RETRIES=0
OLLAMA_MAX_DESCRIPTION_CHARS=12000
OLLAMA_CV_CHUNK_CHARS=1200
OLLAMA_CV_TRUNCATION_RETRIES=4
OLLAMA_CV_MAX_MODEL_CALLS=32
OLLAMA_CV_MAX_OUTPUT_TOKENS=3072
# Explicitly incomplete, source-quoted fallback if tiny Ollama models cannot produce JSON.
OLLAMA_CV_LITERAL_FALLBACK_ENABLED=true

# Optional Phase 3.2. Pull the embedding model before enabling.
ATS_EMBEDDINGS_ENABLED=false
ATS_EMBEDDING_MODEL=nomic-embed-text
ATS_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Phase 3.4: automatically extract source-backed CV profiles after embeddings.
# Requires ATS_EMBEDDINGS_ENABLED=true and a local OLLAMA_MODEL.
ATS_PROFILE_EXTRACTION_ENABLED=false

# Phase 3.5: run a deterministic source evidence audit after candidate profiling.
# Does not approve candidates or bypass human review.
ATS_EVIDENCE_VALIDATION_ENABLED=false

# Phase 3.6: source-backed, non-scoring matching against approved job criteria.
ATS_MATCHING_ENABLED=false

# Phase 3.7: evidence-coverage calculations from approved HR weights only.
ATS_SCORING_ENABLED=false

# Use quick, explicitly incomplete source-only extraction with a 0.5B/1B model.
# For full AI CV analysis, use a more capable evaluation model and disable this.
ATS_AUTOMATIC_PROFILE_FAST_MODE=true
