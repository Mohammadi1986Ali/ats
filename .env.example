ATS_DATA_DIR=data
ATS_MAX_FILE_MB=10
# Optional: keep unset to continue using local SQLite.
# ATS_DATABASE_URL_OVERRIDE=postgresql+psycopg://ats:PASSWORD@localhost:5433/job_hire_ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_THREAD=8
OLLAMA_TIMEOUT=600
OLLAMA_RETRIES=1
OLLAMA_MAX_DESCRIPTION_CHARS=12000
OLLAMA_CV_CHUNK_CHARS=2400
OLLAMA_CV_TRUNCATION_RETRIES=2
OLLAMA_CV_MAX_MODEL_CALLS=16
OLLAMA_CV_MAX_OUTPUT_TOKENS=1536

# Optional Phase 3.2. Pull the embedding model before enabling.
ATS_EMBEDDINGS_ENABLED=false
ATS_EMBEDDING_MODEL=nomic-embed-text
ATS_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Phase 3.4: automatically extract source-backed CV profiles after embeddings.
# Requires ATS_EMBEDDINGS_ENABLED=true and a local OLLAMA_MODEL.
ATS_PROFILE_EXTRACTION_ENABLED=false
